@using SalesManagement.ViewModels.Purchase
@model PurchaseViewModel

@{
    ViewData["Title"] = "Alış Düzenle";
}

<h2>Alış Düzenle</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Ürün</label>
        <select asp-for="ProductId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Products, "Id", "Name"))">
        </select>
    </div>

    <div class="mb-3">
        <label>Cari</label>
        <select asp-for="CustomerId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Customers, "Id", "Customertitle"))">
        </select>
    </div>

    <div class="mb-3">
        <label>Adet</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Birim Fiyat</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>

</form>
