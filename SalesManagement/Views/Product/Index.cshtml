<h3>Ürün Listesi</h3>

<div id="productGrid" style="height: 500px;"></div>

<!-- Buton tablo altına geliyor -->
<div style="margin-top: 10px; text-align: left;">
    <button id="btnAddNew" style="
        background-color: #28a745;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    ">
        Yeni Veri Ekle
    </button>
</div>

<script>
    $(function () {
        $("#productGrid").dxDataGrid({
            dataSource: "/Product/GetProducts",
            keyExpr: "id",
            columns: [
                { dataField: "name", caption: "Ürün Adı" },
                { dataField: "categoryName", caption: "Kategori" },
                { dataField: "salesprice", caption: "Satış Fiyatı" },
                {
                    caption: "Düzenle",
                    width: 120,
                    alignment: "center",
                    cellTemplate: function(container, options) {
                        $("<div>").append(
                            $("<button>")
                                .text("Düzenle")
                                .css({
                                    "background-color": "#28a745",
                                    "color": "white",
                                    "padding": "5px 15px",
                                    "border-radius": "5px",
                                    "border": "none",
                                    "cursor": "pointer"
                                })
                                .on("click", function() {
                                    window.location.href = "/Product/Edit/" + options.data.id;
                                })
                        ).appendTo(container);
                    }
                }
            ],
            showBorders: true,
            paging: { pageSize: 10 },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: { visible: true },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: "Ara..."
            },
            sorting: { mode: "multiple" },
            rowAlternationEnabled: true
        });

        $("#btnAddNew").on("click", function () {
            window.location.href = "/Product/Create";
        });
    });
</script>

