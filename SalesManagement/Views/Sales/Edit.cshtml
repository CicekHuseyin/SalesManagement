@model SalesViewModel
@{
    ViewBag.Title = "Satış Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">Satış Düzenle</h5>
                </div>

                <div class="card-body">
                    <form asp-action="Edit" method="post">

                        <!-- Gizli Id -->
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label">Ürün</label>
                            <select asp-for="ProductId"
                                    asp-items="@(new SelectList(ViewBag.Products, "Id", "Name"))"
                                    class="form-select"
                                    id="ProductSelect"
                                    disabled>
                            </select>

                            <!-- disabled select post edilmez -->
                            <input type="hidden" asp-for="ProductId" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Müşteri</label>
                            <select asp-for="CustomerId"
                                    asp-items="@(new SelectList(ViewBag.Customers, "Id", "Customertitle"))"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Liste Fiyatı</label>
                            <input asp-for="ListPrice"
                                   class="form-control"
                                   readonly
                                   id="ListPrice" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Satış Fiyatı</label>
                            <input asp-for="SalesPrice"
                                   class="form-control"
                                   id="SalesPrice" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">İskonto Oranı (%)</label>
                            <input asp-for="DiscountRate"
                                   class="form-control"
                                   readonly
                                   id="DiscountRate" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adet</label>
                            <input asp-for="Quantity"
                                   class="form-control" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Sales/Index" class="btn btn-secondary">
                                İptal
                            </a>

                            <button type="submit" class="btn btn-success">
                                Güncelle
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Satış fiyatı değişince iskonto hesapla
        $('#SalesPrice').on('input', function () {
            var listPrice = parseFloat($('#ListPrice').val()) || 0;
            var salesPrice = parseFloat($(this).val()) || 0;

            if (listPrice > 0) {
                var discount = ((listPrice - salesPrice) / listPrice * 100).toFixed(2);
                $('#DiscountRate').val(discount);
            } else {
                $('#DiscountRate').val(0);
            }
        });
    </script>
}
