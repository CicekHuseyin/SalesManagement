@{
    ViewBag.Title = "Satış Listesi";
}

@if (TempData["SaleSuccess"] != null)
{
    <div id="successPopup" class="success-popup">
        <div class="popup-content">
            <div class="checkmark">✓</div>
            <h5>@TempData["SaleSuccess"]</h5>
        </div>
    </div>
}


<h3>Satış Listesi</h3>

<div id="salesGrid" style="height: 500px;"></div>

<!-- Buton tablo altına geliyor -->
<div style="margin-top: 10px; text-align: left;">
    <button id="btnAddNew" style="
        background-color: #28a745;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    ">
        Yeni Satış Ekle
    </button>
</div>

<script>
    $(function () {
        $("#salesGrid").dxDataGrid({
            dataSource: "/Sales/GetSales",
            keyExpr: "id",
            columns: [
                { dataField: "productName", caption: "Ürün Adı" },
                { dataField: "customerName", caption: "Müşteri" },
                { dataField: "quantity", caption: "Adet" },
                { dataField: "listprice", caption: "Liste Fiyatı" },
                { dataField: "salesprice", caption: "Satış Fiyatı" },
                { dataField: "discountrate", caption: "İskonto (%)" },
                { dataField: "date", caption: "Satış Tarihi", dataType: "date", format: "dd/MM/yyyy" },
                {
                    caption: "Düzenle",
                    width: 120,
                    alignment: "center",
                    cellTemplate: function(container, options) {
                        $("<div>").append(
                            $("<button>")
                                .text("Düzenle")
                                .css({
                                    "background-color": "#28a745",
                                    "color": "white",
                                    "padding": "5px 15px",
                                    "border-radius": "5px",
                                    "border": "none",
                                    "cursor": "pointer"
                                })
                                .on("click", function() {
                                    window.location.href = "/Sales/Edit/" + options.data.id;
                                })
                        ).appendTo(container);
                    }
                }
            ],
            showBorders: true,
            paging: { pageSize: 10 },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: { visible: true },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: "Ara..."
            },
            sorting: { mode: "multiple" },
            rowAlternationEnabled: true
        });

        $("#btnAddNew").on("click", function () {
            window.location.href = "/Sales/Create";
        });
    });
</script>

<script>
    $(document).ready(function () {
        setTimeout(function () {
            $("#successPopup").fadeOut(500);
        }, 2000);
    });
</script>

